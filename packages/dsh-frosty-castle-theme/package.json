{
  "name": "@rs-dsh/dsh-frosty-castle-theme",
  "version": "0.1.0-rc.1",
  "description": "Frosty Castle Theme: a dark-fantasy frost palette, stone-and-iron frame, crest and carved controls for DSH Web.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/romany-saad/dsh-plugins.git",
    "directory": "packages/dsh-frosty-castle-theme"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "theme"
  ],
  "icon": "./icon.svg",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --check client.js && node --import ./test/no-network.mjs --test test/*.test.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@rs-dsh/dsh-core"
      ]
    }
  },
  "dependencies": {
    "@rs-dsh/dsh-core": "workspace:^"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "devDependencies": {
    "@deepseek-ai/schemastery": "3.18.5"
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.1-rc.2 <0.3.0-0"
  }
}
