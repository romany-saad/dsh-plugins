{
  "name": "@rs-dsh/dsh-cockpit",
  "version": "0.3.0",
  "description": "A durable task board for a DSH hub session: a tree of steps with free-form link fields, kept as a local JSON file that other processes can read.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/romany-saad/dsh-plugins.git",
    "directory": "packages/dsh-cockpit"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness"
  ],
  "exports": {
    ".": "./index.js",
    "./reader": "./reader.js",
    "./client": "./client/client.js",
    "./board.schema.json": "./board.schema.json",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "reader.js",
    "lib",
    "client/client.js",
    "examples",
    "board.schema.json",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --import ./test/no-network.mjs --test test/*.test.js",
    "build:client": "node client/build.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-tool"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-home-paths": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "^0.2.1-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-client-connection": "0.2.1-rc.2",
    "@deepseek-ai/dsh-home-paths": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2"
  }
}
