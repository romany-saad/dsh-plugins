{
  "name": "@rs-dsh/dsh-quote",
  "version": "0.3.0",
  "description": "Quote passages from DSH Web conversations into your next message as composer chips, each with an optional note you can edit; sent quotes render as cards.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/romany-saad/dsh-plugins.git",
    "directory": "packages/dsh-quote"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "quote"
  ],
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --check client.js && node --import ./test/no-network.mjs --test test/*.test.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-input-trigger",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@rs-dsh/dsh-core"
      ]
    }
  },
  "dependencies": {
    "@rs-dsh/dsh-core": "workspace:^"
  },
  "engines": {
    "node": ">=22"
  }
}
